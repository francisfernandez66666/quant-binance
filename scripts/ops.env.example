# ─────────────────────────────────────────────────────────────────────────────
# scripts/ops.env.example — 自运维变量模板（2026-09-26 §N7 修复批）
#
# 缺陷原文（docs/AUDIT_FULL_UAT_20260926.md N7）：公网服务器 IP 与非默认 SSH 端口
#   以字面量散落在 scripts/verify_nightly.sh、scripts/deploy_seoul.sh（注释）、
#   scripts/sync_delta_to_cloud.sh（用法示例）中，随 git 历史 tracked 出仓。
# 修法：仓库内只保留本模板（占位值）；真实值写入 scripts/ops.env（已进 .gitignore，
#   禁止入库）。三个消费脚本在自身目录同级寻找 ops.env，存在即 source、缺失则提示
#   回到本模板复制。
#
# 用法：
#   cp scripts/ops.env.example scripts/ops.env   # 然后填入真实值
#
# 说明：SSH 非默认端口继续由本机 ~/.ssh/config 的 Host 段承载（部署/同步/验证三条链
#   的连接命令均不带 -p，连接方式与 §N7 修复前逐字一致），OPS_SSH_PORT 仅作端口备忘，
#   供人工 ssh 与排障时查阅，脚本不消费。
# ─────────────────────────────────────────────────────────────────────────────

# OPS_SSH_HOST：首尔服务器公网地址（也可填 ~/.ssh/config 里的 Host 别名）
OPS_SSH_HOST=YOUR_QUANT_SSH_HOST

# OPS_SSH_USER：SSH 登录用户（各脚本消费方以 root 为缺省）
OPS_SSH_USER=root

# OPS_SSH_PORT：SSH 端口备忘（真实端口配在本机 ~/.ssh/config 的 Host 段，不入仓）
OPS_SSH_PORT=YOUR_QUANT_SSH_PORT
